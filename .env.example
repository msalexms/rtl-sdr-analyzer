# RTL-SDR Analyzer Environment Variables
# Copy this file to .env and customize as needed

# Input source: auto | usb | rtl_tcp | simulated | file
RTL_SDR__SOURCE__MODE=auto
RTL_SDR__SOURCE__DEVICE_INDEX=0
# RTL_SDR__SOURCE__LIBRARY_PATH=

# RTL-TCP connection (used when source.mode=rtl_tcp or auto fallback)
RTL_SDR__RTL_TCP__HOST=127.0.0.1
RTL_SDR__RTL_TCP__PORT=1234

# Receiver settings
RTL_SDR__RECEIVER__FREQUENCY=98000000
RTL_SDR__RECEIVER__SAMPLE_RATE=2048000
RTL_SDR__RECEIVER__FFT_SIZE=2048
# RTL_SDR__RECEIVER__GAIN=29.7
RTL_SDR__RECEIVER__PPM=0
RTL_SDR__RECEIVER__DIRECT_SAMPLING=0
RTL_SDR__RECEIVER__AGC=false

# DSP settings
RTL_SDR__DSP__WINDOW=blackmanharris
RTL_SDR__DSP__AVERAGING=4
RTL_SDR__DSP__EMA_ALPHA=0.35

# Detector settings
RTL_SDR__DETECTOR__ENABLED=true
RTL_SDR__DETECTOR__POWER_THRESHOLD=-55.0
RTL_SDR__DETECTOR__SNR_THRESHOLD=10.0
RTL_SDR__DETECTOR__BANDWIDTH_THRESHOLD=5000.0
RTL_SDR__DETECTOR__Z_SCORE_THRESHOLD=3.0
RTL_SDR__DETECTOR__DETECTION_WINDOW=5
RTL_SDR__DETECTOR__MIN_DURATION=0.2
RTL_SDR__DETECTOR__COOLDOWN_SECONDS=2.0
RTL_SDR__DETECTOR__TEST_MODE=false

# Display & Web Studio
RTL_SDR__DISPLAY__WATERFALL_LENGTH=120
RTL_SDR__DISPLAY__TARGET_FPS=20
RTL_SDR__WEB__HOST=127.0.0.1
RTL_SDR__WEB__PORT=8080

# Storage
# RTL_SDR__STORAGE__DB_PATH=./events.db
RTL_SDR__STORAGE__RECORDINGS_DIR=./recordings
